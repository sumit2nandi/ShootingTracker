# Copy to .env and adjust.
# Postgres connection string (Aiven example with sslmode).
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
PORT=3000
TZ=Asia/Kolkata
# Google Cloud OAuth 2.0 Web client ID (add your app's origin to Authorized JavaScript origins).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Generate a long random value, for example: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# --- optional (defaults shown) -------------------------------------------
# LOG_LEVEL=debug                # silent | error | warn | info | debug
# SESSION_TTL_SECONDS=604800     # 7 days
# ALLOWLIST_CACHE_MS=20000       # app_users lookup cache
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=30000
# SHOOT_LIST_MAX_ROWS=2000       # safety limit on GET /api/shoots
# FRAME_OPTIONS=SAMEORIGIN       # "none" to allow embedding in an iframe
# DEV_SIGN_IN_EMAIL=you@example.com
#   Development only: treat every request as this (allow-listed) account so the
#   app can be opened without Google credentials. Refused when NODE_ENV=production.
